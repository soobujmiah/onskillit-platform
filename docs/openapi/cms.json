{
  "openapi": "3.1.0",
  "info": {
    "title": "OnSkillIT CMS API",
    "version": "0.1.0",
    "description": "PHASE-04 staff CMS. Writes require session cookie, same-origin and session-bound CSRF header. Public media bytes require explicit publication; all other reads are staff-only and noindex."
