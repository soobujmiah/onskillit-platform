{
  "openapi": "3.1.0",
  "info": { "title": "OnSkillIT identity API", "version": "0.1.0", "description": "PHASE-03 draft contract. Mobile-only recovery is disabled by founding-partner decision." },
  "servers": [{ "url": "/api/v1/identity" }],
  "components": {
    "securitySchemes": { "session": { "type": "apiKey", "in": "cookie", "name": "onskillit_session" } },
    "schemas": {
      "Error": { "type": "object", "required": ["code"], "properties": { "code": { "type": "string" } } },
      "ContactPassword": { "type": "object", "additionalProperties": false, "required": ["contact", "password"], "properties": { "contact": { "type": "string", "maxLength": 254 }, "password": { "type": "string", "minLength": 12, "maxLength": 128 } } },
      "Registration": { "type": "object", "additionalProperties": false, "required": ["contact", "password"], "properties": { "contact": { "type": "string", "maxLength": 254 }, "secondary_contact": { "type": "string", "maxLength": 254, "description": "Optional contact of the other kind" }, "password": { "type": "string", "minLength": 12, "maxLength": 128 } } },
      "Email": { "type": "object", "additionalProperties": false, "required": ["email"], "properties": { "email": { "type": "string", "format": "email" } } },
      "Token": { "type": "object", "additionalProperties": false, "required": ["token"], "properties": { "token": { "type": "string" } } },
      "Reset": { "type": "object", "additionalProperties": false, "required": ["token", "password"], "properties": { "token": { "type": "string" }, "password": { "type": "string", "minLength": 12, "maxLength": 128 } } },
      "ChangePassword": { "type": "object", "additionalProperties": false, "required": ["current_password", "new_password"], "properties": { "current_password": { "type": "string" }, "new_password": { "type": "string", "minLength": 12, "maxLength": 128 } } },
      "Status": { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "type": "string", "enum": ["active", "inactive", "suspended", "deletion_pending"] } } },
      "Grant": { "type": "object", "additionalProperties": false, "required": ["user_id", "role_id", "scope_type", "scope_id"], "properties": { "user_id": { "type": "string", "format": "uuid" }, "role_id": { "type": "string" }, "scope_type": { "type": "string", "enum": ["global", "account", "resource"] }, "scope_id": { "type": "string" }, "reason": { "type": "string", "maxLength": 300 } } }
    },
    "responses": { "Error": { "description": "Safe error code; no account-existence disclosure on recovery.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } }
  },
  "paths": {
    "/registrations": { "post": { "operationId": "register", "summary": "Register an unverified email or mobile account", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Registration" } } } }, "responses": { "201": { "description": "Created" }, "400": { "$ref": "#/components/responses/Error" }, "409": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/sessions": { "post": { "operationId": "login", "summary": "Create revocable cookie session", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ContactPassword" } } } }, "responses": { "200": { "description": "Session cookies set" }, "401": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/session": { "get": { "operationId": "getSession", "security": [{ "session": [] }], "responses": { "200": { "description": "Current session" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/profile": { "get": { "operationId": "getProfile", "security": [{ "session": [] }], "responses": { "200": { "description": "Own account contacts" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/logout": { "post": { "operationId": "logout", "security": [{ "session": [] }], "responses": { "200": { "description": "Session revoked" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/change-password": { "post": { "operationId": "changePassword", "security": [{ "session": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangePassword" } } } }, "responses": { "200": { "description": "Password changed and all sessions revoked" }, "401": { "$ref": "#/components/responses/Error" }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/email-verification-requests": { "post": { "operationId": "requestVerification", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Email" } } } }, "responses": { "202": { "description": "Generic accepted response" } } } },
    "/email-verifications": { "post": { "operationId": "verifyEmail", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Token" } } } }, "responses": { "200": { "description": "Email verified" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/password-reset-requests": { "post": { "operationId": "requestPasswordReset", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Email" } } } }, "responses": { "202": { "description": "Generic accepted response, only verified email can receive a link" } } } },
    "/password-resets": { "post": { "operationId": "resetPassword", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reset" } } } }, "responses": { "200": { "description": "Password changed and sessions revoked" }, "400": { "$ref": "#/components/responses/Error" } } } },
    "/users": { "get": { "operationId": "listUsers", "security": [{ "session": [] }], "description": "Requires users.read global grant.", "responses": { "200": { "description": "Bounded user list" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/users/{id}": { "patch": { "operationId": "changeUserStatus", "security": [{ "session": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Status" } } } }, "responses": { "200": { "description": "Status changed and sessions revoked when inactive" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/roles": { "get": { "operationId": "listRoles", "security": [{ "session": [] }], "responses": { "200": { "description": "Role list" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/role-assignments": { "post": { "operationId": "grantRole", "security": [{ "session": [] }], "description": "Privileged roles are denied pending independent approval workflow.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Grant" } } } }, "responses": { "201": { "description": "Grant recorded and target sessions revoked" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/role-assignments/{id}": { "delete": { "operationId": "revokeRole", "security": [{ "session": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Grant revoked" }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/grant-requests": {
      "get": { "operationId": "listPrivilegedGrants", "security": [{ "session": [] }], "responses": { "200": { "description": "Pending privileged grant requests" }, "403": { "$ref": "#/components/responses/Error" } } },
      "post": { "operationId": "requestPrivilegedGrant", "security": [{ "session": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Grant" } } } }, "responses": { "201": { "description": "Pending request; no role granted" }, "403": { "$ref": "#/components/responses/Error" } } }
    },
    "/grant-requests/{id}/approve": { "post": { "operationId": "approvePrivilegedGrant", "security": [{ "session": [] }], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Second independent administrator approved and role granted" }, "403": { "$ref": "#/components/responses/Error" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/audit": { "get": { "operationId": "listAudit", "security": [{ "session": [] }], "responses": { "200": { "description": "Redacted audit list" }, "403": { "$ref": "#/components/responses/Error" } } } }
  }
}
